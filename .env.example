# Local synthetic demo. No external credentials or paid services required.
APP_ENV=local
AUTH_MODE=local
AI_MODE=demo
EXTERNAL_MODE=preview
DATABASE_URL=sqlite:///./data/recruiter.db
CHECKPOINT_URL=sqlite:///./data/checkpoints.db
FRONTEND_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:8000
LOCAL_STORAGE_DIR=./data/documents
SEED_DEMO=true
ENABLE_DEMO_RESET=false
WORKER_ENABLED=true
# Local APP_SECRET is generated once in ignored data/.local-secret.
APP_SECRET=

# Production: APP_ENV=production, AUTH_MODE=supabase, PostgreSQL URLs,
# strong APP_SECRET, private Supabase bucket, staff provisioned via script.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=resumes

# Set AI_MODE=gemini only after verifying a model's free availability.
# Billing must remain disabled; never submit real candidate data.
GEMINI_API_KEY=
GEMINI_MODEL=

# Set EXTERNAL_MODE=live only for owned test accounts.
RESEND_API_KEY=
RESEND_TEST_INBOX=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/calendar/callback
CALENDAR_ALLOWED_EMAILS=
# Generate once using Fernet.generate_key(); keep stable across deploys.
TOKEN_ENCRYPTION_KEY=
